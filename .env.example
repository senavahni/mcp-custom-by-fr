# MCP Marketing — salin ke .env lalu isi semua nilai CHANGE_ME.
# Komentar HANYA di baris sendiri (scripts\env.bat tidak mendukung komentar di akhir baris).
# Generate secret: python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------- Server ----------
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=4100
LOG_LEVEL=INFO
LOG_DIR=./logs
TIMEZONE=Asia/Jakarta
# minimal 32 karakter; pepper hash API key klien
MCP_KEY_PEPPER=CHANGE_ME_key_pepper_min_32_characters_xx
# toolset default untuk key baru (dipisah koma)
DEFAULT_TOOLSETS=toolbox,data,job
# URL publik server ini (dipakai link export data_export)
PUBLIC_BASE_URL=http://127.0.0.1:4100
STORAGE_DIR=./storage
# aktifkan tool dev toolbox_ping
ENABLE_DEV_TOOLS=false

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://mcp_app:CHANGE_ME@127.0.0.1:5432/marketing_dashboard
DB_SCHEMA=mcp
DB_POOL_SIZE=10
# role migrasi (pemilik schema mcp); dipakai hanya oleh alembic
MIGRATION_DATABASE_URL=postgresql+asyncpg://mcp_owner:CHANGE_ME@127.0.0.1:5432/marketing_dashboard

# ---------- LLM Gateway ----------
LLM_GATEWAY_URL=http://127.0.0.1:8000/v1
LLM_GATEWAY_API_KEY=lgw_CHANGE_ME
LLM_ROUTE_FAST=fast
LLM_ROUTE_SMART=smart
LLM_ROUTE_EMBED=embed-default
LLM_TIMEOUT_S=120
LLM_CACHE_TTL_S=86400

# ---------- Dashboard (contract 1.x) ----------
DASHBOARD_API_URL=http://localhost:3000/api/v1
# Dashboard -> MCP (sama dengan MCP_SERVER_API_KEY di .env Dashboard)
MCP_SERVER_API_KEY=CHANGE_ME_server_api_key_min_32_characters
# MCP -> Dashboard HMAC webhook (sama dengan .env Dashboard)
MCP_WEBHOOK_SECRET=CHANGE_ME_webhook_secret_min_32_characters
# MCP -> Agent API / Service API (sama dengan .env Dashboard)
MCP_SERVICE_TOKEN=CHANGE_ME_service_token_min_32_characters
CONTRACT_VERSION=1.0
WEBHOOK_MAX_RETRY_MINUTES=30
# harus < 120 menit (timeout run di Dashboard)
AGENT_RUN_TIMEOUT_MINUTES=110

# ---------- Agent ----------
AGENT_DEFAULT_RUN_TOKEN_BUDGET=120000
AGENT_MAX_STEPS=25
AGENT_HISTORY_COMPACT_AT_TOKENS=12000

# ---------- Token efficiency ----------
TOOL_OUTPUT_SOFT_TOKENS=1500
TOOL_OUTPUT_HARD_TOKENS=4000
INLINE_ITEMS_MAX=20
RESULT_TTL_DAYS=30
# maks token LLM internal per tool call (analisis deep memakai TOOL_LLM_TOKENS_DEEP)
TOOL_LLM_TOKENS_DEFAULT=20000
TOOL_LLM_TOKENS_DEEP=60000

# ---------- Worker ----------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=500
JOB_DEFAULT_TIMEOUT_S=1800

# ---------- Retensi ----------
AUDIT_RETENTION_DAYS=180
RAW_RETENTION_DAYS=14
SOCIAL_RETENTION_DAYS=180

# ---------- Browser / Selenium ----------
CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROMEDRIVER_PATH=.\bin\chromedriver.exe
BROWSER_PROFILES_DIR=.\browser_profiles
BROWSER_HEADLESS=false
BROWSER_PAGE_TIMEOUT_S=45
SCRAPE_RESPECT_ROBOTS=true
SCRAPE_PER_DOMAIN_RPM=20
SCRAPE_ALLOW_PRIVATE_NETWORK=false

# ---------- X / Threads / Trends ----------
X_BEARER_TOKEN=
X_MAX_READS_PER_DAY=2000
# harga per post yang dibaca X API (pay-per-use) untuk estimasi biaya
X_PRICE_PER_READ_USD=0.005
X_API_BASE_URL=https://api.x.com/2
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
# unofficial | browser | official
TRENDS_PROVIDER=unofficial
TRENDS_DEFAULT_GEO=ID
TRENDS_CACHE_TTL_S=86400
# jeda minimum antar permintaan ke Google Trends (detik)
TRENDS_MIN_INTERVAL_S=5
TRENDS_BASE_URL=https://trends.google.com
# isi hanya bila akses Google Trends API resmi (alpha) disetujui
TRENDS_OFFICIAL_API_KEY=

# ---------- NLP ----------
SENTIMENT_MODEL_DIR=./models/sentiment-id
SENTIMENT_LLM_THRESHOLD=0.60
# gateway | local
EMBED_PROVIDER=gateway
EMBED_DIM=1536
LOCAL_EMBED_MODEL_DIR=./models/embed-local
